# GitHub App Configuration
GITHUB_APP_ID=your_app_id_here
# 方式一：填写 .pem 文件路径（推荐，避免多行值解析问题）
GITHUB_APP_PRIVATE_KEY=/path/to/your-app.private-key.pem
# 方式二：直接填写 key 内容（仅限单行格式，如 PKCS8）
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEp...\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# App slug（用于 review_requested 事件判断），通常为 App 名称的小写连字符形式
GITHUB_APP_SLUG=pr-reviewer

# LLM API Configuration
# API Key (support both LLM_API_KEY and ANTHROPIC_API_KEY for backward compat)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# Base URL — defaults to Anthropic, uncomment and change for other providers:
# DeepSeek: https://api.deepseek.com/anthropic
# LLM_BASE_URL=https://api.anthropic.com
# Model names — defaults to Claude, change for other providers:
# DeepSeek: deepseek-v4-flash / deepseek-v4-pro
# LLM_MODEL_FAST=claude-haiku-4-5
# LLM_MODEL_POWERFUL=claude-sonnet-4-6

# Server
PORT=8080
